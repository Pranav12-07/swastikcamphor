# ─────────────────────────────────────────────────────────────
# Swastik Camphor — environment variables template
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to GitHub.
# ─────────────────────────────────────────────────────────────

# Lovable Cloud / database (browser + server)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only database key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Lovable platform (server-only, used for email sending / connectors)
LOVABLE_API_KEY="your-lovable-api-key"
LOVABLE_SEND_URL=""

# Public site URL used in emails and receipts
SITE_URL="https://your-domain.example"

# Shop mailbox (Hostinger SMTP) — order emails
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_EMAIL_PASSWORD="your-mailbox-password"

# Where admin order alerts are sent (fallback inbox)
ADMIN_NOTIFICATION_EMAIL="shop@example.com"

# PhonePe payments
PHONEPE_CLIENT_ID="your-phonepe-client-id"
PHONEPE_CLIENT_SECRET="your-phonepe-client-secret"
PHONEPE_CLIENT_VERSION="1"
PHONEPE_MERCHANT_ID="your-merchant-id"
PHONEPE_SALT_KEY="your-salt-key"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="production"
PHONEPE_ENVIRONMENT="production"
PHONEPE_WEBHOOK_USERNAME="your-webhook-username"
PHONEPE_WEBHOOK_PASSWORD="your-webhook-password"

# WhatsApp OTP login (optional)
WHATSAPP_API_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_OTP_TEMPLATE_NAME="your-template-name"
WHATSAPP_OTP_TEMPLATE_LANG="en"
